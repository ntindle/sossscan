{
  "name": "sosf-guide",
  "version": "0.2.0",
  "private": true,
  "description": "Security guide and scanner for open source maintainers, built from GitHub Secure Open Source Fund evidence",
  "license": "MIT",
  "repository": "github:ntindle/sossscan",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "npm run build:cli && next dev --port 3341",
    "build": "npm run build:cli && next build",
    "start": "next start",
    "build:cli": "node scripts/build-cli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "ossfuzz": "node scripts/ossfuzz-refresh.ts",
    "smoke": "node scripts/smoke.ts"
  },
  "dependencies": {
    "diff": "9.0.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  }
}
